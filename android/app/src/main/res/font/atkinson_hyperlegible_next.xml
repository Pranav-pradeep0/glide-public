<?xml version="1.0" encoding="utf-8"?>
<!-- Atkinson Hyperlegible Next (SIL OFL 1.1, see res/raw/ofl_atkinson_hyperlegible_next.txt).
     Two variable files, one entry per weight, so RN picks real weights and italics.
     Registered as "AtkinsonHyperlegibleNext" in MainApplication. -->
<font-family xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto">
    <font android:font="@font/atkinson_next" android:fontStyle="normal" android:fontWeight="200" android:fontVariationSettings="'wght' 200"
        app:font="@font/atkinson_next" app:fontStyle="normal" app:fontWeight="200" app:fontVariationSettings="'wght' 200" />
    <font android:font="@font/atkinson_next" android:fontStyle="normal" android:fontWeight="300" android:fontVariationSettings="'wght' 300"
        app:font="@font/atkinson_next" app:fontStyle="normal" app:fontWeight="300" app:fontVariationSettings="'wght' 300" />
    <font android:font="@font/atkinson_next" android:fontStyle="normal" android:fontWeight="400" android:fontVariationSettings="'wght' 400"
        app:font="@font/atkinson_next" app:fontStyle="normal" app:fontWeight="400" app:fontVariationSettings="'wght' 400" />
    <font android:font="@font/atkinson_next" android:fontStyle="normal" android:fontWeight="500" android:fontVariationSettings="'wght' 500"
        app:font="@font/atkinson_next" app:fontStyle="normal" app:fontWeight="500" app:fontVariationSettings="'wght' 500" />
    <font android:font="@font/atkinson_next" android:fontStyle="normal" android:fontWeight="600" android:fontVariationSettings="'wght' 600"
        app:font="@font/atkinson_next" app:fontStyle="normal" app:fontWeight="600" app:fontVariationSettings="'wght' 600" />
    <font android:font="@font/atkinson_next" android:fontStyle="normal" android:fontWeight="700" android:fontVariationSettings="'wght' 700"
        app:font="@font/atkinson_next" app:fontStyle="normal" app:fontWeight="700" app:fontVariationSettings="'wght' 700" />
    <font android:font="@font/atkinson_next" android:fontStyle="normal" android:fontWeight="800" android:fontVariationSettings="'wght' 800"
        app:font="@font/atkinson_next" app:fontStyle="normal" app:fontWeight="800" app:fontVariationSettings="'wght' 800" />
    <font android:font="@font/atkinson_next_italic" android:fontStyle="italic" android:fontWeight="200" android:fontVariationSettings="'wght' 200"
        app:font="@font/atkinson_next_italic" app:fontStyle="italic" app:fontWeight="200" app:fontVariationSettings="'wght' 200" />
    <font android:font="@font/atkinson_next_italic" android:fontStyle="italic" android:fontWeight="300" android:fontVariationSettings="'wght' 300"
        app:font="@font/atkinson_next_italic" app:fontStyle="italic" app:fontWeight="300" app:fontVariationSettings="'wght' 300" />
    <font android:font="@font/atkinson_next_italic" android:fontStyle="italic" android:fontWeight="400" android:fontVariationSettings="'wght' 400"
        app:font="@font/atkinson_next_italic" app:fontStyle="italic" app:fontWeight="400" app:fontVariationSettings="'wght' 400" />
    <font android:font="@font/atkinson_next_italic" android:fontStyle="italic" android:fontWeight="500" android:fontVariationSettings="'wght' 500"
        app:font="@font/atkinson_next_italic" app:fontStyle="italic" app:fontWeight="500" app:fontVariationSettings="'wght' 500" />
    <font android:font="@font/atkinson_next_italic" android:fontStyle="italic" android:fontWeight="600" android:fontVariationSettings="'wght' 600"
        app:font="@font/atkinson_next_italic" app:fontStyle="italic" app:fontWeight="600" app:fontVariationSettings="'wght' 600" />
    <font android:font="@font/atkinson_next_italic" android:fontStyle="italic" android:fontWeight="700" android:fontVariationSettings="'wght' 700"
        app:font="@font/atkinson_next_italic" app:fontStyle="italic" app:fontWeight="700" app:fontVariationSettings="'wght' 700" />
    <font android:font="@font/atkinson_next_italic" android:fontStyle="italic" android:fontWeight="800" android:fontVariationSettings="'wght' 800"
        app:font="@font/atkinson_next_italic" app:fontStyle="italic" app:fontWeight="800" app:fontVariationSettings="'wght' 800" />
</font-family>
